# .env untuk pengembangan lokal (SQLite, tanpa layanan luar).
# Salin: cp .env.example .env && php artisan key:generate
# Contoh untuk server production ada di .env.production.example.
APP_NAME="Tactical Police Multiview"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database: SQLite. Buat filenya sekali: php -r "touch('database/database.sqlite');"
# Untuk MySQL lokal, ganti DB_CONNECTION=mysql dan isi DB_* di bawah.
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ime_police
# DB_USERNAME=root
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# Session, Cache, & Queue
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# Email: ditulis ke storage/logs/laravel.log, tidak benar-benar dikirim
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="dev@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Integrasi opsional (boleh kosong saat pengembangan)
# -----------------------------------------------------------------------------
# YouTube Data API: fallback untuk scraper & verifikasi channel
YOUTUBE_API_KEY=
# Webhook Discord untuk masukan & moderasi Bio-Link
DISCORD_FEEDBACK_WEBHOOK=
DISCORD_TACTICAL_WEBHOOK_URL=

# Kontak bantuan Tactical Bio-Link Hub
BIOLINKS_ADMIN_EMAIL=admin@example.com
BIOLINKS_ADMIN_WHATSAPP=6281234567890

# Batas hari tidak patroli sebelum officer dianggap Hiatus
POLICE_HIATUS_DAYS=14

# Analytics & SEO (kosongkan saat pengembangan)
GOOGLE_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
VITE_GA_MEASUREMENT_ID="${GA_MEASUREMENT_ID}"
VITE_APP_NAME="${APP_NAME}"
