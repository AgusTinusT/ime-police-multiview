# Contoh .env untuk server production (MySQL, queue database, SMTP).
# Untuk pengembangan lokal pakai .env.example. Jangan pernah commit .env asli.
APP_NAME="Tactical Police Multiview"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://police.domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Database Configuration (MySQL / MariaDB untuk Production)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ime_police
DB_USERNAME=ime_police
# Wajib diganti dengan password acak, mis. hasil: openssl rand -hex 20
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Session, Cache, & Queue (Database Driver untuk Multi-worker)
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# -----------------------------------------------------------------------------
# Redis Configuration (Opsional jika ingin beralih dari database ke Redis)
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Email / SMTP Configuration (Brevo / Sendinblue Relay)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_smtp_login@smtp-brevo.com
MAIL_PASSWORD=your_brevo_smtp_key
MAIL_FROM_ADDRESS="no-reply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Object Storage S3 (IDCloudHost, storage account "storage-s3")
# -----------------------------------------------------------------------------
# Disk "s3" di config/filesystems.php. Ambil Access Key & Secret Key dari panel
# IDCloudHost > Object Storage > storage-s3. Isi HANYA di .env server, jangan
# di-commit atau dikirim lewat chat. Cek koneksi setelah diisi:
#   php artisan storage:check-s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Wajib diisi untuk AWS SDK. Pakai region yang tertera di panel; bila tidak ada,
# penyedia S3-compatible umumnya menerima us-east-1.
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ime-police-duty
AWS_ENDPOINT=https://is3.cloudhost.id
# Alamat bucket berbentuk https://is3.cloudhost.id/ime-police-duty/... (path-style)
AWS_USE_PATH_STYLE_ENDPOINT=true
# URL publik file (opsional). Kosongkan bila bucket privat: aplikasi akan memakai
# tautan bertanda tangan (signed URL) yang kedaluwarsa.
AWS_URL=

# -----------------------------------------------------------------------------
# YouTube API Configuration (Opsional / Fallback untuk scraper & verifikasi channel)
# -----------------------------------------------------------------------------
YOUTUBE_API_KEY=

# -----------------------------------------------------------------------------
# Discord Webhook Notifications
# -----------------------------------------------------------------------------
# Webhook masukan/feedback pengunjung
DISCORD_FEEDBACK_WEBHOOK=
# Webhook notifikasi klaim profil / moderasi Tactical Bio-Link
DISCORD_TACTICAL_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Tactical Bio-Link Hub Support Contacts
# -----------------------------------------------------------------------------
BIOLINKS_ADMIN_EMAIL=admin@domain-anda.com
BIOLINKS_ADMIN_WHATSAPP=6281234567890

# -----------------------------------------------------------------------------
# Police Duty Tracking & Roster Policy
# -----------------------------------------------------------------------------
# Batas hari tidak patroli sebelum officer dianggap status Hiatus (default 14 hari)
POLICE_HIATUS_DAYS=14
# Officer baru di-highlight di dashboard selama N hari sejak ditambahkan (default 14)
POLICE_NEW_OFFICER_DAYS=14

# -----------------------------------------------------------------------------
# Halaman Dukungan (/dukung). Angka biaya & target diatur di config/support.php
# -----------------------------------------------------------------------------
SUPPORT_DONATE_URL=https://bagibagi.co/Gusti-Aidan

# -----------------------------------------------------------------------------
# Analytics, SEO & Frontend Build (Vite)
# -----------------------------------------------------------------------------
# Kode verifikasi kepemilikan Google Search Console (opsional jika menggunakan meta tag)
GOOGLE_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
VITE_GA_MEASUREMENT_ID="${GA_MEASUREMENT_ID}"
VITE_APP_NAME="${APP_NAME}"
